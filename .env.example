# Use either a TMDB v4 read access token or a v3 API key.
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_TOKEN is also accepted as a backwards-compatible alias.
TMDB_API_KEY=

# Used to supplement and verify director/year metadata by IMDb ID.
OMDB_API_KEY=

# Optional brand / QR overrides.
DAILY_POSTER_BRAND=FRAME/LINE
DAILY_POSTER_TAGLINE=A FILM FOR EVERY DAY
DAILY_POSTER_QR_URL=
